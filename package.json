{
  "name": "zotero-library-search",
  "type": "module",
  "version": "0.2.0",
  "description": "Search library catalogs and repositories directly from Zotero",
  "homepage": "https://github.com/CrispStrobe/CrispZotLib",
  "config": {
    "addonName": "Library Search",
    "addonID": "librarysearch@example.com",
    "addonRef": "librarysearch",
    "addonInstance": "LibrarySearch",
    "prefsPrefix": "extensions.zotero.librarysearch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrispStrobe/CrispZotLib.git"
  },
  "author": "CrispStrobe",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-deps": "npm update --save",
    "test:coverage": "vitest run --coverage --coverage.include='src/**'",
    "probe:endpoints": "LIVE_PROBE=1 vitest run test/live/endpointHealth.test.ts",
    "validate:zotero": "node scripts/validate-zotero-schema.mjs"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@xmldom/xmldom": ">=0.9.12",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "zotero-plugin-scaffold": "^0.9.1",
    "zotero-types": "^4.1.3"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.9.12",
    "postcss": ">=8.5.23",
    "@humanfs/node": ">=0.16.8",
    "brace-expansion": ">=5.0.9"
  }
}
